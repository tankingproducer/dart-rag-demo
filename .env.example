# 이 파일을 .env 로 복사한 뒤 값을 채우세요.  (cp .env.example .env)
# .env 는 절대 git 에 커밋하지 마세요.

# [필수] OpenDART 인증키 — https://opendart.fss.or.kr → 인증키 신청/관리 (무료, 즉시 발급)
OPENDART_API_KEY=

# [LLM] 아래 중 하나만 있으면 됩니다. 둘 다 없으면 LLM 없이 "관련 발췌 상위 3개"만 출력(추출식 폴백).
# Groq 무료 API — https://console.groq.com → API Keys  (무료 티어: 분당 8,000 토큰)
GROQ_API_KEY=
# 선택: Groq 모델 변경 (기본 openai/gpt-oss-120b, 대안 qwen/qwen3.8-27b, openai/gpt-oss-20b)
# GROQ_MODEL=openai/gpt-oss-120b

# OpenAI (유료) — 있으면 LLM(gpt-4o-mini) + 임베딩(text-embedding-3-small) 둘 다 사용 → 검색 품질 향상
# OPENAI_API_KEY=
# LLM_MODEL=gpt-4o-mini
# EMBED_MODEL=text-embedding-3-small
